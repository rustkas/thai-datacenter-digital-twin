    'has_sea_access': [False, True, True, False],        # Crucial for Deep Sea Water Cooling (DSWC)
    'electricity_cost_kwh_thb': [4.5, 4.2, 4.8, 4.0],    # Base electricity tariffs
    'land_cost_sqm_thb': [50000, 12000, 25000, 6000],    # Capital expenditure index for land
    'dc_construction_index': [1.1, 1.0, 1.3, 1.05]       # Logistics and supply chain cost modifier
}

df_regions = pd.DataFrame(regions_data)
print("Candidate regions loaded into Digital Twin:")
print(df_regions[['region_name', 'avg_air_temp_c', 'electricity_cost_kwh_thb', 'land_cost_sqm_thb']])



def get_sea_temperature_by_depth(depth_meters, surface_temp=29.0):
    """
    Simulates the thermocline profile for Gulf of Thailand / Andaman Sea.
    Deep sea water cooling (DSWC) provides massive PUE advantages if accessible.
    """
    if depth_meters == 0:
        return surface_temp
    # Rapid drop in temperature down to thermocline floor
    temp = surface_temp - (15.0 * (1 - np.exp(-depth_meters / 150.0)))
    return max(temp, 4.5) # Ocean floor bottom limit

def calculate_cooling_pue(ambient_temp, cooling_type='air', sea_depth_m=0):
    """
    Calculates Power Usage Effectiveness (PUE) contribution from cooling.
    Baseline IT Load PUE is 1.0. Perfect cooling adds 0.0, traditional adds more.
    """
    if cooling_type == 'sea_deep' and sea_depth_m > 0:
        water_temp = get_sea_temperature_by_depth(sea_depth_m)
        # Deep water requires pumping power but bypasses high ambient air temperatures
        cooling_pue_contribution = 0.08 + (water_temp * 0.003)
    else:
        # Air cooling efficiency degrades with higher ambient tropical temperatures
        cooling_pue_contribution = 0.25 + (ambient_temp - 25.0) * 0.015
    
    return 1.0 + cooling_pue_contribution

# Verify physics model
print(f"Sea Temp at 0m: {get_sea_temperature_by_depth(0)}°C")
print(f"Sea Temp at 300m: {get_sea_temperature_by_depth(300):.2f}°C")
print(f"Air Cooling PUE (30.5°C): {calculate_cooling_pue(30.5, 'air'):.3f}")
print(f"Deep Sea Cooling PUE (300m): {calculate_cooling_pue(25.8, 'sea_deep', 300):.3f}")


def evaluate_site_financials(row, target_it_capacity_mw=20, cooling_type='air', sea_depth_m=0):
    """
    Evaluates total cost of ownership (TCO) per 1 MW of IT load for a specific scenario.
    """
    # 1. Determine optimized PUE based on geography and tech
    if row['has_sea_access'] and cooling_type == 'sea_deep':
        actual_cooling = 'sea_deep'
        actual_depth = sea_depth_m
    else:
        actual_cooling = 'air'
        actual_depth = 0
        
    pue = calculate_cooling_pue(row['avg_air_temp_c'], actual_cooling, actual_depth)
    
    # 2. Power Consumption Calculations (1 MW IT load * PUE * 24 hours * 365 days)
    annual_it_kwh_per_mw = 1000 * 24 * 365
    total_annual_kwh_per_mw = annual_it_kwh_per_mw * pue
    
    annual_electricity_cost_thb = total_annual_kwh_per_mw * row['electricity_cost_kwh_thb']
    cooling_only_cost_thb = (total_annual_kwh_per_mw - annual_it_kwh_per_mw) * row['electricity_cost_kwh_thb']
    
    # 3. Capital Expenditure (CAPEX) Simulation annualized per MW
    # Approximate footprints: 1 MW IT requires ~1500 sqm of total facility land
    land_required_sqm = 1500 
    base_dc_build_cost_per_mw = 150_000_000 # 150M THB base cost per MW
    
    total_land_cost = land_required_sqm * row['land_cost_sqm_thb']
    total_build_cost = base_dc_build_cost_per_mw * row['dc_construction_index']
    
    # Annualized CAPEX over a 15-year lifecycle
    annualized_capex_per_mw = (total_land_cost + total_build_cost) / 15
    
    # Total Cost Score (OPEX + Capitalized CAPEX)
    total_annual_cost_per_mw = annual_electricity_cost_thb + annualized_capex_per_mw
    
    # Maximum possible capacity estimation based on local grid infrastructure constraints
    max_capacity_mw = 200 / row['dc_construction_index'] if not row['has_sea_access'] else 500
    
    return {
        'Region': row['region_name'],
        'PUE': round(pue, 3),
        'Max Possible Capacity (MW)': round(max_capacity_mw, 1),
        'Annual Cooling Cost per 1MW (THB)': round(cooling_only_cost_thb, 2),
        'Total Annual Cost per 1MW (THB)': round(total_annual_cost_per_mw, 2),
        'Cooling Tech Used': actual_cooling
    }

# Run simulation for all regions using standard Air Cooling
results_list = []
for idx, row in df_regions.iterrows():
    # If the region has sea access, simulate advanced DSWC optimization scenario
    cooling = 'sea_deep' if row['has_sea_access'] else 'air'
    depth = 200 if row['has_sea_access'] else 0
    res = evaluate_site_financials(row, cooling_type=cooling, sea_depth_m=depth)
    results_list.append(res)

df_results = pd.DataFrame(results_list)


