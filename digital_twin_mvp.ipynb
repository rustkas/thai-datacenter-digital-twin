regions_data = {
    'region_name': ['Bangkok (Central)', 'Chonburi (Eastern Seaboard)', 'Phuket (South)', 'Chiang Mai (North)'],
    'latitude': [13.7563, 13.3611, 7.8804, 18.7883],
